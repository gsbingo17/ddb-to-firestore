{
  "migration": {
    "mode": "migrate",
    "batchSize": 200,
    "checkpointFrequency": 1,
    "maxRetries": 3,
    "retryDelayMs": 1000
  },
  "parallelism": {
    "dynamodbReaders": 4,
    "firestoreWriters": 4,
    "segmentCount": 1,
    "maxConcurrentPairs": 1
  },
  "firestore": {
    "projectId": "your-gcp-project-id",
    "credentialsFile": "/path/to/service-account-key.json"
  },
  "databasePairs": [
    {
      "name": "users-migration",
      "source": {
        "region": "us-west-2",
        "tableName": "mock-data-table-1",
        "endpoint": "http://localhost:32331"
      },
      "target": {
        "database": "target",
        "collection": "mock_data"
      },
      "mapping": {
        "collectionNaming": "preserve",
        "fieldNaming": "preserve",
        "indexCreation": true,
        "keyFields": {
          "partitionKey": "id",
          "sortKey": ""
        }
      }
    }
  ],
  "checkpoint": {
    "storage": "file",
    "path": "./checkpoints"
  },
  "logging": {
    "level": "info",
    "format": "json",
    "output": "stdout"
  }
}
